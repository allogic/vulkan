#version 460 core

#extension GL_ARB_shading_language_include : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout (local_size_x = 8, local_size_x = 8, local_size_x = 8) in;

layout (binding = 0) buffer vdb_brick_t {
	uint64_t mask_buffer[];
} vdb_brick;

layout (push_constant) uniform vdb_terrain_gen_info_t {
	ivec3 position;
	int lod;
} vdb_terrain_gen_info;

#include "vdb.glsl"

float vdb_dummy_surface_density(ivec3 position, int voxel_count) {
  float fx = (float(position.x) + 0.5) / voxel_count * 2.0 - 1.0;
  float fy = (float(position.y) + 0.5) / voxel_count * 2.0 - 1.0;
  float fz = (float(position.z) + 0.5) / voxel_count * 2.0 - 1.0;

  float nx = 0.7071;
  float ny = 0.4082;
  float nz = 0.5773;

  return fx * nx + fy * ny + fz * nz;
}

void main() {
	ivec3 brick_position = vdb_terrain_gen_info.position;
	ivec3 voxel_position = ivec3(gl_GlobalInvocationID.xyz);

	ivec3 position = brick_position + voxel_position;

	float density = vdb_dummy_surface_density(position, VDB_BRICK_SIZE);

	if (density > 0.0) {
		vdb_brick_set(0, position.x, position.y, position.z);
	} else {
		vdb_brick_clr(0, position.x, position.y, position.z);
	}

	vdb_brick_set(0, position.x, position.y, position.z);

	// int i = vdb_brick_voxel_index(0, 63, 63, 63);
	// vdb_brick.mask_buffer[vdb_brick_mask_offset_lod0 + (i >> 6)] = 32;
}