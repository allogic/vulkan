#version 460 core

#extension GL_ARB_shading_language_include : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_mesh_shader : require

#include "../vdb/common.glsl"

const int SUB_DIVISION = 4;
const int SUBPARTS_PER_LAYER = SUB_DIVISION * SUB_DIVISION;

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) uniform camera_info_t {
	vec3 position;
	float max_ray_distance;
	mat4 view;
	mat4 projection;
	mat4 view_projection;
	mat4 view_projection_inv;
	vec4 frustum_plane[6];
} camera_info;
layout (binding = 1) uniform vdb_occlusion_info_t {
	float cull_center_x;
	float cull_center_y;
	float cull_radius;
	float meshlet_density;
} vdb_occlusion_info;
layout (binding = 2) readonly buffer vdb_brick_info_buffer_t {
	vdb_brick_info_t brick_info[];
} vdb_brick_info_buffer;
layout (binding = 3) readonly buffer vdb_brick_mask_buffer_t {
	vdb_brick_mask_t brick_mask[];
} vdb_brick_mask_buffer;

taskPayloadSharedEXT vdb_payload_data_t vdb_payload_data;

bool aabb_in_frustum(vec3 minp, vec3 maxp) {

	for (int i = 0; i < 6; i++) {

		vec3 position = vec3(
			camera_info.frustum_plane[i].x > 0.0 ? maxp.x : minp.x,
			camera_info.frustum_plane[i].y > 0.0 ? maxp.y : minp.y,
			camera_info.frustum_plane[i].z > 0.0 ? maxp.z : minp.z
		);

		if (dot(camera_info.frustum_plane[i], vec4(position, 1.0)) < 0.0) {
			return false;
		}
	}

	return true;
}

void main() {
	int brick_index = int(gl_GlobalInvocationID.x);
	
	vdb_brick_info_t brick_info = vdb_brick_info_buffer.brick_info[brick_index];
	vdb_brick_mask_t brick_mask = vdb_brick_mask_buffer.brick_mask[brick_index];

	if (!aabb_in_frustum(brick_info.aabb_min, brick_info.aabb_max)) {
		return;
	}

    if (brick_mask.any_z_faces == 0u) {
        return;
    }

	//EmitMeshTasksEXT(VDB_BRICK_SIZE * SUBPARTS_PER_LAYER, 1, 1);

	uint active_slice_count_x = 0u;
	uint active_slice_count_y = 0u;
	uint active_slice_count_z = 0u;

    for (int slice = 0; slice < VDB_BRICK_SIZE; slice++) {

        if ((brick_mask.any_x_faces & (1u << slice)) != 0u) {
            active_slice_count_x++;
            // Optional: if active_slice_count > some max, break or handle in multiple dispatches
        }

		if ((brick_mask.any_y_faces & (1u << slice)) != 0u) {
            active_slice_count_y++;
            // Optional: if active_slice_count > some max, break or handle in multiple dispatches
        }

		if ((brick_mask.any_z_faces & (1u << slice)) != 0u) {
            active_slice_count_z++;
            // Optional: if active_slice_count > some max, break or handle in multiple dispatches
        }
    }

	vdb_payload_data.brick_position = brick_info.brick_position;
	vdb_payload_data.brick_index = brick_index;

	vdb_payload_data.axis = VDB_PAYLOAD_AXIS_X;
	EmitMeshTasksEXT(SUBPARTS_PER_LAYER, active_slice_count_x, 1u);

	vdb_payload_data.axis = VDB_PAYLOAD_AXIS_Y;
	EmitMeshTasksEXT(SUBPARTS_PER_LAYER, active_slice_count_y, 1u);

	vdb_payload_data.axis = VDB_PAYLOAD_AXIS_Z;
	EmitMeshTasksEXT(SUBPARTS_PER_LAYER, active_slice_count_z, 1u);
}