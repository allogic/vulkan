#version 460 core

#extension GL_ARB_shading_language_include : require
#extension GL_EXT_nonuniform_qualifier : require

layout (local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

#include "fwd.glsl"

layout (binding = 0) uniform vdb_info_t {
	ivec3 cluster_dim;
} vdb_info;

layout (binding = 1, r32ui) uniform uimage3D vdb_brick[];

layout (push_constant) uniform vdb_lod_gen_push_constant_t {
	ivec3 brick_position;
	int brick_index;
	int brick_lod;
} vdb_lod_gen_push_constant;

#define EXCLUDE_HDDA_TRACER
#include "vdb.glsl"

void main() {
	ivec3 curr_voxel_position = ivec3(gl_GlobalInvocationID.xyz);
	ivec3 c0 = curr_voxel_position * 2;
	ivec3 brick_position = vdb_lod_gen_push_constant.brick_position;

	int curr_lod = vdb_lod_gen_push_constant.brick_lod;
	int child_lod = vdb_lod_gen_push_constant.brick_lod - 1;

	int curr_voxel_count = vdb_voxels_per_axis(curr_lod);

	int brick_index = VDB_BRICK_INDEX(brick_position.x, brick_position.y, brick_position.z);

	if (curr_voxel_position.x < curr_voxel_count &&
		curr_voxel_position.y < curr_voxel_count &&
		curr_voxel_position.z < curr_voxel_count) {

		bool solid = false;

		for (int z = 0; z < 2; z++) {
			for (int y = 0; y < 2; y++) {
				for (int x = 0; x < 2; x++) {

					ivec3 child_voxel_position = c0 + ivec3(x, y, z);

					uint child_voxel = VDB_GET_VOXEL(child_lod, brick_index, child_voxel_position);

					if ((child_voxel & VDB_VOXEL_IS_SOLID_BIT) == VDB_VOXEL_IS_SOLID_BIT) {
						solid = true;
					}
				}
			}
		}

		uint curr_voxel = VDB_GET_VOXEL(curr_lod, brick_index, curr_voxel_position);

		if (solid) {
			curr_voxel &= ~VDB_VOXEL_IS_SOLID_BIT;
		} else {
			curr_voxel |= VDB_VOXEL_IS_SOLID_BIT;
		}

		VDB_SET_VOXEL(curr_lod, brick_index, curr_voxel_position, curr_voxel);
	}
}