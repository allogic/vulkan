#version 460 core

#extension GL_ARB_shading_language_include : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_mesh_shader : require

#include "../vdb/common.glsl"

const int MAX_VERTICES = 256;
const int MAX_PRIMITIVES = 128;
const int SUB_DIVISION = 4;
const int SUBPARTS_PER_LAYER = SUB_DIVISION * SUB_DIVISION;
const int SUB_SIZE = VDB_BRICK_SIZE / SUB_DIVISION;

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout (triangles, max_vertices = MAX_VERTICES, max_primitives = MAX_PRIMITIVES) out;

layout (location = 0) out vec4 output_color[];

layout (binding = 0) uniform camera_info_t {
	vec3 position;
	float max_ray_distance;
	mat4 view;
	mat4 projection;
	mat4 view_projection;
	mat4 view_projection_inv;
	vec4 frustum_plane[6];
} camera_info;
layout (binding = 2) readonly buffer vdb_brick_info_buffer_t {
	vdb_brick_info_t brick_info[];
} vdb_brick_info_buffer;
layout (binding = 3) readonly buffer vdb_brick_mask_buffer_t {
	vdb_brick_mask_t brick_mask[];
} vdb_brick_mask_buffer;

taskPayloadSharedEXT vdb_payload_data_t vdb_payload_data;

void greedy_emit_x(
    int slice,
    inout int vert_count,
    inout int prim_count,
    int sub_y,
    int sub_z
) {
    const int TILE = 8;
    int y_base = sub_y * TILE;
    int z_base = sub_z * TILE;

    uint local_rows[TILE];

    for (int lz = 0; lz < TILE; lz++) {
        uint mask = 0u;
        for (int ly = 0; ly < TILE; ly++) {
            int gy = y_base + ly;
            int gz = z_base + lz;
            uint idx = gz * VDB_BRICK_SIZE + gy + 1u;
            if ((vdb_brick_mask_buffer.brick_mask[vdb_payload_data.brick_index].x_mask[idx] & (1u << slice)) != 0u) {
                mask |= (1u << ly);
            }
        }
        local_rows[lz] = mask;
    }

    for (int lz = 0; lz < TILE; ) {
        uint row = local_rows[lz];
        while (row != 0u) {
            int ly = findLSB(row);
            uint remaining = row >> ly;
            int w = findLSB(~remaining);
            if (ly + w > TILE) w = TILE - ly;

            uint quad_mask = (w == 32) ? 0xFFFFFFFFu : (((1u << w) - 1u) << ly);

            int h = 1;
            while (lz + h < TILE && (local_rows[lz + h] & quad_mask) == quad_mask) {
                h++;
            }

            if (vert_count + 4 > MAX_VERTICES || prim_count + 2 > MAX_PRIMITIVES) return;

            vec3 base = vdb_payload_data.brick_position * float(VDB_BRICK_SIZE) +
                        vec3(float(slice) + 1.0, float(y_base + ly), float(z_base + lz));

            vec3 v0 = base + vec3(0.0, 0.0, 0.0);
            vec3 v1 = base + vec3(0.0, float(w), 0.0);
            vec3 v2 = base + vec3(0.0, float(w), float(h));
            vec3 v3 = base + vec3(0.0, 0.0, float(h));

            gl_MeshVerticesEXT[vert_count + 0].gl_Position = camera_info.view_projection * vec4(v0, 1.0);
            gl_MeshVerticesEXT[vert_count + 1].gl_Position = camera_info.view_projection * vec4(v1, 1.0);
            gl_MeshVerticesEXT[vert_count + 2].gl_Position = camera_info.view_projection * vec4(v2, 1.0);
            gl_MeshVerticesEXT[vert_count + 3].gl_Position = camera_info.view_projection * vec4(v3, 1.0);

            output_color[vert_count + 0] = vec4(1.0, 0.2, 0.2, 1.0);
            output_color[vert_count + 1] = vec4(1.0, 0.2, 0.2, 1.0);
            output_color[vert_count + 2] = vec4(1.0, 0.2, 0.2, 1.0);
            output_color[vert_count + 3] = vec4(1.0, 0.2, 0.2, 1.0);

            gl_PrimitiveTriangleIndicesEXT[prim_count + 0] = uvec3(vert_count+0, vert_count+1, vert_count+2);
            gl_PrimitiveTriangleIndicesEXT[prim_count + 1] = uvec3(vert_count+0, vert_count+2, vert_count+3);

            vert_count += 4;
            prim_count += 2;

            for (int hh = 0; hh < h; hh++) {
                local_rows[lz + hh] &= ~quad_mask;
            }
            row = local_rows[lz];
        }
        lz++;
    }
}
void greedy_emit_y(
    int slice,
    inout int vert_count,
    inout int prim_count,
    int sub_x,
    int sub_z
) {
    const int TILE = 8;
    int x_base = sub_x * TILE;
    int z_base = sub_z * TILE;

    uint local_rows[TILE];

    for (int lz = 0; lz < TILE; lz++) {
        uint mask = 0u;
        for (int lx = 0; lx < TILE; lx++) {
            int gx = x_base + lx;
            int gz = z_base + lz;
            uint idx = gz * VDB_BRICK_SIZE + gx + 1u;
            if ((vdb_brick_mask_buffer.brick_mask[vdb_payload_data.brick_index].y_mask[idx] & (1u << slice)) != 0u) {
                mask |= (1u << lx);
            }
        }
        local_rows[lz] = mask;
    }

    for (int lz = 0; lz < TILE; ) {
        uint row = local_rows[lz];
        while (row != 0u) {
            int lx = findLSB(row);
            uint remaining = row >> lx;
            int w = findLSB(~remaining);
            if (lx + w > TILE) w = TILE - lx;

            uint quad_mask = (w == 32) ? 0xFFFFFFFFu : (((1u << w) - 1u) << lx);

            int h = 1;
            while (lz + h < TILE && (local_rows[lz + h] & quad_mask) == quad_mask) {
                h++;
            }

            if (vert_count + 4 > MAX_VERTICES || prim_count + 2 > MAX_PRIMITIVES) return;

            vec3 base = vdb_payload_data.brick_position * float(VDB_BRICK_SIZE) +
                        vec3(float(x_base + lx), float(slice) + 1.0, float(z_base + lz));

            vec3 v0 = base + vec3(0.0, 0.0, 0.0);
            vec3 v1 = base + vec3(float(w), 0.0, 0.0);
            vec3 v2 = base + vec3(float(w), 0.0, float(h));
            vec3 v3 = base + vec3(0.0, 0.0, float(h));

            gl_MeshVerticesEXT[vert_count + 0].gl_Position = camera_info.view_projection * vec4(v0, 1.0);
            gl_MeshVerticesEXT[vert_count + 1].gl_Position = camera_info.view_projection * vec4(v1, 1.0);
            gl_MeshVerticesEXT[vert_count + 2].gl_Position = camera_info.view_projection * vec4(v2, 1.0);
            gl_MeshVerticesEXT[vert_count + 3].gl_Position = camera_info.view_projection * vec4(v3, 1.0);

            output_color[vert_count + 0] = vec4(0.2, 1.0, 0.2, 1.0);
            output_color[vert_count + 1] = vec4(0.2, 1.0, 0.2, 1.0);
            output_color[vert_count + 2] = vec4(0.2, 1.0, 0.2, 1.0);
            output_color[vert_count + 3] = vec4(0.2, 1.0, 0.2, 1.0);

            gl_PrimitiveTriangleIndicesEXT[prim_count + 0] = uvec3(vert_count+0, vert_count+2, vert_count+1);
            gl_PrimitiveTriangleIndicesEXT[prim_count + 1] = uvec3(vert_count+0, vert_count+3, vert_count+2);

            vert_count += 4;
            prim_count += 2;

            for (int hh = 0; hh < h; hh++) {
                local_rows[lz + hh] &= ~quad_mask;
            }
            row = local_rows[lz];
        }
        lz++;
    }
}
void greedy_emit_z(
    int slice,
    inout int vert_count,
    inout int prim_count,
    int sub_x,
    int sub_y
) {
    const int TILE = 8;
    int x_base = sub_x * TILE;
    int y_base = sub_y * TILE;

    uint local_rows[TILE];

    for (int ly = 0; ly < TILE; ly++) {
        uint mask = 0u;
        for (int lx = 0; lx < TILE; lx++) {
            int gx = x_base + lx;
            int gy = y_base + ly;
            uint idx = gy * VDB_BRICK_SIZE + gx + 1u;
            if ((vdb_brick_mask_buffer.brick_mask[vdb_payload_data.brick_index].z_mask[idx] & (1u << slice)) != 0u) {
                mask |= (1u << lx);
            }
        }
        local_rows[ly] = mask;
    }

    for (int ly = 0; ly < TILE; ) {
        uint row = local_rows[ly];
        while (row != 0u) {
            int lx = findLSB(row);
            uint remaining = row >> lx;
            int w = findLSB(~remaining);
            if (lx + w > TILE) w = TILE - lx;

            uint quad_mask = (w == 32) ? 0xFFFFFFFFu : (((1u << w) - 1u) << lx);

            int h = 1;
            while (ly + h < TILE && (local_rows[ly + h] & quad_mask) == quad_mask) {
                h++;
            }

            if (vert_count + 4 > MAX_VERTICES || prim_count + 2 > MAX_PRIMITIVES) return;

            vec3 base = vdb_payload_data.brick_position * float(VDB_BRICK_SIZE) +
                        vec3(float(x_base + lx), float(y_base + ly), float(slice) + 1.0);

            vec3 v0 = base + vec3(0.0, 0.0, 0.0);
            vec3 v1 = base + vec3(float(w), 0.0, 0.0);
            vec3 v2 = base + vec3(float(w), float(h), 0.0);
            vec3 v3 = base + vec3(0.0, float(h), 0.0);

            gl_MeshVerticesEXT[vert_count + 0].gl_Position = camera_info.view_projection * vec4(v0, 1.0);
            gl_MeshVerticesEXT[vert_count + 1].gl_Position = camera_info.view_projection * vec4(v1, 1.0);
            gl_MeshVerticesEXT[vert_count + 2].gl_Position = camera_info.view_projection * vec4(v2, 1.0);
            gl_MeshVerticesEXT[vert_count + 3].gl_Position = camera_info.view_projection * vec4(v3, 1.0);

            output_color[vert_count + 0] = vec4(0.0, 0.0, 1.0, 1.0);
            output_color[vert_count + 1] = vec4(0.0, 0.0, 1.0, 1.0);
            output_color[vert_count + 2] = vec4(0.0, 0.0, 1.0, 1.0);
            output_color[vert_count + 3] = vec4(0.0, 0.0, 1.0, 1.0);

            gl_PrimitiveTriangleIndicesEXT[prim_count + 0] = uvec3(vert_count+0, vert_count+1, vert_count+2);
            gl_PrimitiveTriangleIndicesEXT[prim_count + 1] = uvec3(vert_count+0, vert_count+2, vert_count+3);

            vert_count += 4;
            prim_count += 2;

            for (int hh = 0; hh < h; hh++) {
                local_rows[ly + hh] &= ~quad_mask;
            }
            row = local_rows[ly];
        }
        ly++;
    }
}

void main() {
	int active_idx = int(gl_WorkGroupID.y);           // 0 .. active-1
    int sub_id     = int(gl_WorkGroupID.x);           // 0 .. 15

    int sub_x = sub_id % SUB_DIVISION;                // 0..3
    int sub_y = sub_id / SUB_DIVISION;                // 0..3

    // Find the real z-slice by scanning the bitmask again
    // (small cost – 32 iterations max, done once per meshlet)
    int real_x = -1;
    int real_y = -1;
    int real_z = -1;

    int current_active_x = 0;
    int current_active_y = 0;
    int current_active_z = 0;

    uint any_x = vdb_brick_mask_buffer.brick_mask[vdb_payload_data.brick_index].any_x_faces;
	uint any_y = vdb_brick_mask_buffer.brick_mask[vdb_payload_data.brick_index].any_y_faces;
	uint any_z = vdb_brick_mask_buffer.brick_mask[vdb_payload_data.brick_index].any_z_faces;

	for (int candidate = 0; candidate < VDB_BRICK_SIZE; candidate++) {

		if ((any_x & (1u << candidate)) != 0u) {
			if (current_active_x == active_idx) {
				if (real_x == -1) {
					real_x = candidate;
				}
			}
			current_active_x++;
		}

		if ((any_y & (1u << candidate)) != 0u) {
			if (current_active_y == active_idx) {
				if (real_y == -1) {
					real_y = candidate;
				}
			}
			current_active_y++;
		}

		if ((any_z & (1u << candidate)) != 0u) {
			if (current_active_z == active_idx) {
				if (real_z == -1) {
					real_z = candidate;
				}
			}
			current_active_z++;
		}
	}

	if (real_x < 0 || real_y < 0 || real_z < 0) {

		SetMeshOutputsEXT(0, 0);

		return;
	}

	int vert_count = 0;
	int prim_count = 0;

	greedy_emit_x(real_x, vert_count, prim_count, sub_x, sub_y);
	greedy_emit_y(real_y, vert_count, prim_count, sub_x, sub_y);
	greedy_emit_z(real_z, vert_count, prim_count, sub_x, sub_y);

	// Always set outputs (even if zero)
	SetMeshOutputsEXT(vert_count, prim_count);
}